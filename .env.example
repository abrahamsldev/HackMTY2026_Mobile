# Mobile client: public values only.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# For legacy keys use EXPO_PUBLIC_SUPABASE_ANON_KEY instead.

# Origin of the deployed AGENT, not the MCP endpoint. Leave empty until deployed.
# Example: https://your-agent.example.com
EXPO_PUBLIC_AGENT_URL=

# HORIZON_API_KEY, MCP_SERVER_URL and MCP_AUTH_MODE belong to the agent's
# server environment. Never prefix MCP credentials with EXPO_PUBLIC_.
